# Voice Text TTS Docker 环境变量配置示例
# 复制此文件为 .env 并根据需要修改配置

# ==================== TTS API 配置 ====================
# TTS API 服务地址
API_HOST=127.0.0.1

# TTS API 服务端口
API_PORT=50000

# TTS 工作模式
API_MODE=zero_shot

# ==================== Web 服务配置 ====================
# Web 服务监听地址 (Docker 容器内部使用 0.0.0.0)
SERVER_NAME=0.0.0.0

# Web 服务端口 (容器内部端口)
SERVER_PORT=7863

# ==================== ASR 配置 ====================
# 是否启用 ASR 功能 (true/false)
ASR_ENABLED=false

# ASR 后端类型
ASR_BACKEND_TYPE=funasr

# FunASR WebSocket 地址（如果启用 ASR）
# ASR_FUNASR_URI=ws://localhost:10095/ws

# FunASR 识别模式
# ASR_FUNASR_MODE=2pass-offline

# ==================== 限制配置 ====================
# 最大文本长度限制
MAX_TEXT_LENGTH=1000

# ==================== 其他配置 ====================
# Prompt 文本
# PROMPT_TEXT=You are a helpful assistant.<|endofprompt|>

# 预设目录（默认使用容器内 /app/presets）
# PRESETS_DIR=/app/presets

# 音频采样率
# AUDIO_SAMPLE_RATE=16000

# 音频声道数
# AUDIO_CHANNELS=1
