# ===========================================
# Voice Text TTS Docker 环境变量配置
# 复制此文件为 .env 并根据需要修改配置
# ===========================================

# ===========================================
# API 配置
# ===========================================
# TTS API服务器地址（使用 host.docker.internal 访问宿主机）
API_HOST=host.docker.internal
# TTS API服务器端口
API_PORT=50000
# TTS API模式 (zero_shot, etc.)
API_MODE=zero_shot

# ===========================================
# Prompt 配置
# ===========================================
# 系统提示文本，会与用户输入的参考音频文本拼接
PROMPT_TEXT=You are a helpful assistant.<|endofprompt|>

# ===========================================
# 服务器配置
# ===========================================
# Gradio服务器端口
SERVER_PORT=7862

# ===========================================
# Gradio Share 模式
# ===========================================
# 是否启用 Gradio Share 公网链接模式
# 设置为 true 可避免 Docker 环境中的 localhost 检查问题
# 但会创建公网访问链接（仅用于测试，生产环境建议设为 false）
GRADIO_SHARE=true

# ===========================================
# 文本限制
# ===========================================
# 最大文本长度
MAX_TEXT_LENGTH=1000

# ===========================================
# ASR 配置
# ===========================================
# 是否启用ASR功能 (true/false)
ASR_ENABLED=false
# ASR后端类型 (funasr, websocket)
ASR_BACKEND_TYPE=funasr

# ===========================================
# ASR FunASR 配置
# ===========================================
# FunASR WebSocket地址
ASR_FUNASR_URI=ws://localhost:10095/ws
# FunASR模式 (2pass-offline, 2pass-online, offline, online)
ASR_FUNASR_MODE=2pass-offline
# FunASR分块大小 [chunk_size_s, chunk_size_ms, chunk_interval]
ASR_FUNASR_CHUNK_SIZE=[5, 10, 5]
# FunASR分块间隔（毫秒）
ASR_FUNASR_CHUNK_INTERVAL=10
# FunASR编码器回看块数
ASR_FUNASR_ENCODER_CHUNK_LOOK_BACK=4
# FunASR解码器回看块数
ASR_FUNASR_DECODER_CHUNK_LOOK_BACK=0
# FunASR热词配置（JSON格式）
ASR_FUNASR_HOTWORDS={}
# FunASR是否使用ITN (true/false)
ASR_FUNASR_USE_ITN=true
